{
  "name": "study-plan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "server": "cd server && tsx watch src/server.ts",
    "build": "npm --workspace server run build && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json --noEmit && vite build --config vite.config.ts",
    "build:client": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.27",
    "jest": "^30.3.0",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  },
  "description": "Frontend for the AI-powered Study Plan Generator.",
  "main": "vite.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardojpires/ai_study.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "types": "./vite.config.d.ts",
  "bugs": {
    "url": "https://github.com/leonardojpires/ai_study/issues"
  },
  "homepage": "https://github.com/leonardojpires/ai_study#readme"
}
